# Connect IQ build configuration. Sources default to source/ and resources to
# resources/; only the manifest needs to be named explicitly.
project.manifest = manifest.xml

# Launcher icons. Connect IQ does not pick an icon by size, and each product
# declares its own launcher-icon dimensions, so every device points at the
# icons/<w>x<h> folder matching it. Without this the base icon is silently
# scaled and the compiler warns. Regenerate with the icons script if the
# product list changes.

approachs50.resourcePath = $(approachs50.resourcePath);icons/56x56
approachs7042mm.resourcePath = $(approachs7042mm.resourcePath);icons/60x60
